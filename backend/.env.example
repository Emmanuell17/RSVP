# First path segment after postgresql:// must be a Postgres ROLE that exists (not the word "user").
# Local example: postgresql://YOUR_MAC_USERNAME:PASSWORD@localhost:5432/rsvp_db
# Often the role is your macOS login name, or "postgres" if you created that role.
DATABASE_URL=postgresql://YOUR_DB_USERNAME:YOUR_PASSWORD@localhost:5432/rsvp_db
# Cloud URLs with ?sslmode=require work; for local Postgres set DATABASE_SSL=false.
# On Heroku, SSL is enabled automatically (DYNO); set DATABASE_SSL=false only if your DB has no TLS.
# DATABASE_SSL=false
APP_PASSWORD=your-secret-password
ADMIN_PASSWORD=your-separate-admin-password
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
# Optional (default 7d): ADMIN_TOKEN_TTL=7d

# Create tables once: psql "$DATABASE_URL" -f schema.sql

# Optional: email a short summary after each RSVP (omit NOTIFY_EMAIL to disable).
NOTIFY_EMAIL=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey_or_username
SMTP_PASS=secret_or_app_password
# Optional overrides:
# SMTP_FROM="Wedding RSVP <rsvp@example.com>"
# NOTIFY_SUBJECT=New RSVP
# NOTIFY_REMOVAL_SUBJECT=RSVP removed by admin
